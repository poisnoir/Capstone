* text=auto eol=lf

# Binary documents and images
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.docx binary
*.xlsx binary
*.xls binary
*.zip binary
*.raw binary
*.bit binary
*.dcp binary
*.step binary
*.stp binary
